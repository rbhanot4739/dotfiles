#!/usr/bin/env bash

read -r theme bg_mode < <(get-theme)
echo "Switching to theme: $theme with background mode: $bg_mode"

GHOSTTY_DIR="$HOME/.config/ghostty"
GHOSTTY_TEMPLATE="$GHOSTTY_DIR/config.template"
GHOSTTY_COLORS="$GHOSTTY_DIR/colorschemes/${theme}-${bg_mode}.conf"
GHOSTTY_CONFIG="$GHOSTTY_DIR/config"

if [[ -f "$GHOSTTY_TEMPLATE" && -f "$GHOSTTY_COLORS" ]]; then
  cat "$GHOSTTY_TEMPLATE" "$GHOSTTY_COLORS" > "$GHOSTTY_CONFIG"
  pkill -HUP ghostty 2>/dev/null
fi

# Update neovim load_colorscheme
if command -v nvr >/dev/null 2>&1; then
  nvr --serverlist | xargs -I {} nvr --servername {} --remote-send '<Esc>:lua Load_colorscheme()<CR>'
fi

# Update tmux theme
if [[ -n $TMUX ]]; then
  tmux-theme-switcher "$theme" 2> /dev/null
fi

# update delta theme
declare -A special_themes=(
  ["everforest"]=1
  ["gruvbox"]=1
  ["gruvbox-material"]=1
)
if [[ -v special_themes["$theme"] ]]; then
    theme="${theme}-${bg_mode}"
fi

sd '^(\s*features\s*=).*$' "\$1 ${theme}" "$HOME"/.delta-gitconfig

# update delta bg_mode in lazygit
sd '(pager: delta[^"]*?)(?: --(light|dark))?([^"]*")' "\$1 --${bg_mode}\$3" "$HOME"/.config/lazygit/config.yml

# Sync theme to remote SSH hosts (fire-and-forget, no slowdown)
_sync_remote_theme() {
  local mode="$1"
  local hosts=()
  if [[ -f ~/.ssh/config.custom ]]; then
    while IFS= read -r line; do
      [[ "$line" =~ ^Host[[:space:]]+([a-zA-Z0-9_-]+)$ ]] && hosts+=("${BASH_REMATCH[1]}")
    done <~/.ssh/config.custom
  fi
  for host in "${hosts[@]}"; do
    ssh -o ConnectTimeout=2 -o BatchMode=yes "$host" \
      "echo '$mode' >~/.bg_mode && [[ -x ~/.config/themes/bin/theme-switch ]] && ~/.config/themes/bin/theme-switch" \
      &>/dev/null &
  done
}
_sync_remote_theme "$bg_mode"
