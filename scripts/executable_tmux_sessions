#!/usr/bin/env bash

export PROMPT_MODE_FILE="$HOME/.tmux_session_mode"

source "$HOME/scripts/truncate_path.sh"
export -f truncate_path

# ================================================================================
#                           SESSION ACTIONS
# ================================================================================
# Functions that perform actions on tmux sessions

# Get all tmux sessions, marking only the current session as (attached)
# Output: session_name\tsession_name (attached)
get_tmux_sessions() {
  local current_session
  current_session=$(tmux display-message -p '#S' 2>/dev/null)
  printf "HEADER\t\033[2m%s\033[0m\n" "Session"
  tmux list-sessions -F '#S' 2>/dev/null |
  while IFS= read -r session; do
    if [[ "$session" == "$current_session" ]]; then
      printf "%s\t%s (attached)\n" "$session" "$session"
    else
      printf "%s\t%s\n" "$session" "$session"
    fi
  done || true
}
export -f get_tmux_sessions

# Parse ssh command-line args and return remote host (best effort).
extract_ssh_host_from_args() {
  local ssh_args="$1"
  [[ -z "$ssh_args" ]] && return 1

  local -a tokens
  read -r -a tokens <<< "$ssh_args"
  [[ "${#tokens[@]}" -lt 2 ]] && return 1

  local expects_value=0
  local token
  local option_needs_arg='^-(b|c|D|E|e|F|I|i|J|L|l|m|O|o|p|Q|R|S|W|w)$'

  for token in "${tokens[@]:1}"; do
    if (( expects_value )); then
      expects_value=0
      continue
    fi

    if [[ "$token" == "--" ]]; then
      continue
    fi

    if [[ "$token" == -* ]]; then
      if [[ "$token" =~ $option_needs_arg ]]; then
        expects_value=1
      fi
      continue
    fi

    token="${token#*@}"
    token="${token#[}"
    token="${token%]}"
    printf '%s' "$token"
    return 0
  done

  return 1
}
export -f extract_ssh_host_from_args

# Get all tmux panes with smart labels and aligned columns
# Output: target_id\tformatted_display (target_id hidden by FZF --with-nth 2..)
# Display: session(dim)  path(normal)  label(cyan)
get_tmux_panes() {
  local current_pane
  local hostname_str
  current_pane=$(tmux display-message -p '#S:#{window_index}.#{pane_index}')
  hostname_str=$(hostname 2>/dev/null)

  # Collect raw pane data (§ as field separator)
  local raw_data
  raw_data=$(tmux list-panes -a -F "#S:#{window_index}.#{pane_index}§#S§#{pane_current_command}§#{?#{@custom_title},#{@custom_title},#{pane_title}}§#{pane_current_path}§#{pane_pid}" | grep -v "^${current_pane}§")

  [[ -z "$raw_data" ]] && return

  # Build a process snapshot once and cache first child args by parent pid.
  local -A first_child_args_by_parent=()
  local ppid pid args
  while read -r ppid pid args; do
    [[ -z "$ppid" || -z "$pid" ]] && continue
    if [[ -z "${first_child_args_by_parent[$ppid]+x}" ]]; then
      first_child_args_by_parent[$ppid]="$args"
    fi
  done < <(ps -axo ppid=,pid=,args= 2>/dev/null)

  # Two-pass approach: first compute column widths, then format output
  local -a targets=() sessions=() paths=() labels=()
  local max_session=7 max_path=4

  while IFS='§' read -r target_id session cmd title path pid; do
    # Path: replace HOME with ~, take basename
    path="${path/#$HOME/\~}"
    local path_tail="${path##*/}"
    [[ -z "$path_tail" ]] && path_tail="$path"

    # Smart label:
    #   version-number cmd (Claude Code) → trimmed pane_title
    #   real command (not a shell) → command name
    #   shell with custom title (not hostname/empty) → pane_title
    #   otherwise → empty
    local label=""
    local first_child_args="" ssh_args="" ssh_host=""
    first_child_args="${first_child_args_by_parent[$pid]}"

    if [[ "$cmd" == "ssh" ]]; then
      ssh_args="$first_child_args"
      if [[ "$ssh_args" != ssh* && "$ssh_args" != */ssh* ]]; then
        ssh_args=$(ps -p "$pid" -o args= 2>/dev/null)
      fi
      ssh_host=$(extract_ssh_host_from_args "$ssh_args")
    fi

    # Check for AI agent icons specifically
    # Determine the base label first
    if [[ "$cmd" == "ssh" && -n "$ssh_host" ]]; then
      label="$ssh_host"
    elif [[ "$cmd" =~ ^[0-9]+\.[0-9]+ ]]; then
      label=$(printf '%s' "$title" | sed 's/^[^[:alnum:]]*//;s/[[:space:]]*$//')
    elif [[ "$cmd" != "zsh" && "$cmd" != "bash" && "$cmd" != "fish" ]]; then
      label="$cmd"
    elif [[ -n "$title" && "$title" != "$hostname_str" ]]; then
      label="$title"
    fi

    # Prefix command/tool labels with a bracketed tag for clear visual identification.
    # Uses bash [[ =~ ]] (POSIX ERE) instead of grep to avoid shell aliases (e.g. grep→rg
    # where -E means encoding, not extended regex). ${var,,} lowercases for case-insensitive
    # matching. Claude Code sets pane_current_command to its version number (e.g. 2.1.104).
    local combined="${cmd,,} ${title,,}"
    local ai_fallback_pattern='node|ai|agent|planner'
    if [[ "$cmd" == "ssh" ]]; then
      label="[ssh]${label:+ ${label}}"
    elif [[ "$cmd" =~ ^[0-9]+\.[0-9]+ ]]; then
      label="[Claude]${label:+ ${label}}"
    elif [[ "$combined" =~ cursor ]]; then
      label="[Cursor]${title:+ ${title}}"
    elif [[ "$cmd" == "node" ]]; then
      if [[ "${first_child_args,,}" =~ cursor ]]; then
        label="[Cursor]${title:+ ${title}}"
      fi
    elif [[ "$combined" =~ gemini ]]; then
      label="[Gemini]${title:+ ${title}}"
    elif [[ "$combined" =~ $ai_fallback_pattern ]]; then
      label="[AI]${title:+ ${title}}"
    fi

    if [[ -z "$label" ]]; then
      if [[ "$cmd" == "zsh" || "$cmd" == "bash" || "$cmd" == "fish" ]]; then
        label="$cmd"
      elif [[ -n "$cmd" ]]; then
        label="$cmd"
      else
        label="[idle]"
      fi
    fi

    targets+=("$target_id")
    sessions+=("$session")
    paths+=("$path_tail")
    labels+=("$label")

    (( ${#session} > max_session )) && max_session=${#session}
    (( ${#path_tail} > max_path )) && max_path=${#path_tail}
  done <<< "$raw_data"

  # Second pass: format with aligned columns and ANSI colors
  local dim=$'\033[2m' cyan=$'\033[36m' reset=$'\033[0m'

  local header_display
  header_display=$(printf "${dim}%-${max_session}s${reset}          %-${max_path}s            ${cyan}%s${reset}" \
    "Session" "Path" "Command")
  printf "HEADER\t%s\n" "$header_display"

  for ((i = 0; i < ${#targets[@]}; i++)); do
    local display
    if [[ -n "${labels[$i]}" ]]; then
      display=$(printf "${dim}%-${max_session}s${reset}          %-${max_path}s            ${cyan}%s${reset}" \
        "${sessions[$i]}" "${paths[$i]}" "${labels[$i]}")
    else
      display=$(printf "${dim}%-${max_session}s${reset}          %-${max_path}s" \
        "${sessions[$i]}" "${paths[$i]}")
    fi
    printf "%s\t%s\n" "${targets[$i]}" "$display"
  done
}
export -f get_tmux_panes

# Output: full_path\ttruncated_display
get_zoxide_dirs() {
  printf "HEADER\t\033[2m%s\033[0m\n" "Directory"
  zoxide query -l | grep -v '.*\/\s*$' |
  while IFS= read -r dir; do
    local display
    display=$(truncate_path "$dir" 2 2)
    printf "%s\t%s\n" "$dir" "$display"
  done
}
export -f get_zoxide_dirs

# Delete a tmux session
del_session() {
  local session="${1%%$'\t'*}"
  local current_session
  current_session=$(tmux display-message -p '#S' 2>/dev/null)
  [[ "$session" == "$current_session" ]] && return
  printf '\n  Kill session "%s"? [y/N]: ' "$session"
  IFS= read -rn1 r; echo
  [[ "$r" == y ]] && tmux kill-session -t "$session"
}
export -f del_session

# Rename a tmux session
rename_session() {
  local old_name="${1%%$'\t'*}"
  printf '\n  Rename session "%s" to: ' "$old_name"
  local name old_stty
  old_stty=$(stty -g 2>/dev/null)
  stty intr $'\x1b' 2>/dev/null
  trap 'stty "$old_stty" 2>/dev/null; exit 0' INT
  IFS= read -r name
  stty "$old_stty" 2>/dev/null
  [[ -n "$name" ]] && tmux rename-session -t "$old_name" "$name"
}
export -f rename_session

# Kill a specific pane
del_pane() {
  local pane_target="${1%%$'\t'*}"
  local current_pane
  current_pane=$(tmux display-message -p '#S:#{window_index}.#{pane_index}' 2>/dev/null)
  [[ "$pane_target" == "$current_pane" ]] && return
  printf '\n  Kill pane "%s"? [y/N]: ' "$pane_target"
  IFS= read -rn1 r; echo
  [[ "$r" == y ]] && tmux kill-pane -t "$pane_target"
}
export -f del_pane

# Rename a pane title
rename_pane() {
  local pane_target="${1%%$'\t'*}"
  printf '\n  New title for pane "%s": ' "$pane_target"
  local name old_stty
  old_stty=$(stty -g 2>/dev/null)
  stty intr $'\x1b' 2>/dev/null
  trap 'stty "$old_stty" 2>/dev/null; exit 0' INT
  IFS= read -r name
  stty "$old_stty" 2>/dev/null
  if [[ -n "$name" ]]; then
    tmux set-option -p -t "$pane_target" @custom_title "$name"
    tmux select-pane -t "$pane_target" -T "$name"
  fi
}
export -f rename_pane

# Remove directory from zoxide
del_zoxide_dir() {
  local dir="${1%%$'\t'*}"
  printf '\n  Remove "%s" from zoxide? [y/N]: ' "${dir/#$HOME/~}"
  IFS= read -rn1 r; echo
  [[ "$r" == y ]] && zoxide remove "$dir"
}
export -f del_zoxide_dir

# Mode-aware dispatchers for FZF bindings
dispatch_del() {
  local mode
  mode=$(cat "$PROMPT_MODE_FILE" 2>/dev/null || echo "tmux")
  case "$mode" in
    panes)  del_pane "$1" ;;
    tmux)   del_session "$1" ;;
    zoxide) del_zoxide_dir "$1" ;;
  esac
}
export -f dispatch_del

dispatch_rename() {
  local mode
  mode=$(cat "$PROMPT_MODE_FILE" 2>/dev/null || echo "tmux")
  case "$mode" in
    panes) rename_pane "$1" ;;
    tmux)  rename_session "$1" ;;
  esac
}
export -f dispatch_rename

reload_current() {
  local mode
  mode=$(cat "$PROMPT_MODE_FILE" 2>/dev/null || echo "tmux")
  case "$mode" in
    panes)      get_tmux_panes ;;
    tmux)       get_tmux_sessions ;;
    zoxide)     get_zoxide_dirs ;;
  esac
}
export -f reload_current

# Return mode-appropriate footer text
# Usage: get_footer [mode]  — if mode not given, reads from mode file
get_footer() {
  local mode="${1:-$(cat "$PROMPT_MODE_FILE" 2>/dev/null || echo "tmux")}"
  local common='󰌌 Keymaps:\n  󰘳  ?         Switch Modes\n  󰐊  Alt-p     Toggle Preview'
  case "$mode" in
    panes)      printf "${common}\n  󰌑  Enter     Switch to Pane\n  󰑕  Ctrl-e    Rename Pane Title\n  󰅖  Del       Kill Pane" ;;
    tmux)       printf "${common}\n  󰌑  Enter     Attach/Start Session\n  󰑕  Ctrl-e    Rename Session\n  󰅖  Del       Kill Session" ;;
    zoxide)     printf "${common}\n  󰌑  Enter     Open Directory\n  󰅖  Del       Remove from Zoxide" ;;
  esac
}
export -f get_footer

# Create new session with user confirmation
create_session() {
  local session="$1"
  local tmux_action="$2"
  echo -n "No existing session found with name '$session'. Do you want to create a new session? (y/n): "
  read -r -n 1 response
  response=${response:-Y}
  if [[ "$response" =~ ^[Yy]$ ]]; then
    echo -e "\nCreating new session named '$session'"
    tmux new-session -d -s "$1" && tmux "$tmux_action" -t "$session"
  else
    echo -e "\nSession creation aborted."
  fi
}
export -f create_session

# Generate preview content based on current mode
generate_preview() {
  local selection="$1"
  local mode_file="$PROMPT_MODE_FILE"
  local current_mode

  # Extract action key (before tab) — works for all modes
  local action_key="${selection%%$'\t'*}"

  # Read current mode, default to tmux if file doesn't exist
  if [[ -f "$mode_file" ]]; then
    current_mode=$(cat "$mode_file")
  else
    current_mode="tmux"
  fi

  case "$current_mode" in
  "panes")
    # Fetch pane metadata
    local pane_path cmd
    pane_path=$(tmux display-message -p -t "$action_key" '#{pane_current_path}' 2>/dev/null)
    cmd=$(tmux display-message -p -t "$action_key" '#{pane_current_command}' 2>/dev/null)
    
    # Replace $HOME with ~ for cleaner display
    pane_path="${pane_path/#$HOME/\~}"
    
    # Print the stylized header
    echo -e "\033[36m🖥️  Pane: \033[0m$action_key"
    echo -e "\033[36m📁 Path: \033[0m$pane_path"
    echo -e "\033[36m🚀 Cmd:  \033[0m$cmd"
    echo -e "\033[2m──────────────────────────────────────────────────\033[0m"
    echo ""
    
    # Print a tail of pane output to keep previews responsive on large scrollback.
    tmux capture-pane -ep -S -200 -t "$action_key" 2>/dev/null
    ;;
  "zoxide")
    # action_key is the full directory path
    local dir_path="$action_key"

    if [[ -n "$dir_path" && -d "$dir_path" ]]; then
      echo "📁 Directory: $dir_path"
      echo "📊 Frequency: $(zoxide query --score "$dir_path" 2>/dev/null | awk '{print $1}' || echo "N/A")"
      echo ""

      # Show directory contents
      if command -v eza >/dev/null 2>&1; then
        echo "📂 Contents:"
        eza -a --color=always --group-directories-first --time-style=relative "$dir_path" 2>/dev/null | head -20
      elif command -v ls >/dev/null 2>&1; then
        echo "📂 Contents:"
        ls -a --color=always "$dir_path" 2>/dev/null | head -20
      fi

      # Show git status if it's a git repository
      if [[ -d "$dir_path/.git" ]]; then
        echo ""
        echo "🔗 Git Status:"
        cd "$dir_path" 2>/dev/null && git status --porcelain 2>/dev/null | head -10
      fi
    fi
    ;;
  "tmux" | *)
    # action_key is the session name
    local session_name="$action_key"
    if tmux has-session -t "$session_name" 2>/dev/null; then
      echo "Status: 🟢 Active"
      echo "Session: $session_name"
      echo ""
      echo "Windows:"
      tmux list-windows -t "$session_name" 2>/dev/null
    fi
    ;;
  esac
}
export -f generate_preview

set_mode() {
  echo "$1" >"$PROMPT_MODE_FILE"
}
export -f set_mode

# ================================================================================
#                              FZF CONFIGURATION
# ================================================================================
tmux_panes_prompt="  󰍹  Tmux Panes › "
zoxide_prompt="  󰉋  Zoxide Directories › "
tmux_sessions_prompt="  󰓫  Tmux Sessions › "
TRANSFORMER="
if [[ \$FZF_PROMPT =~ Panes ]]; then
  echo \"change-prompt(${tmux_sessions_prompt})+reload(set_mode tmux; get_tmux_sessions)+transform-footer:get_footer tmux\"
elif [[ \$FZF_PROMPT =~ Sessions ]]; then
  if [[ \$(command -v zoxide) ]]; then
    echo \"change-prompt(${zoxide_prompt})+reload(set_mode zoxide; get_zoxide_dirs)+transform-footer:get_footer zoxide\"
  else
    echo \"change-prompt(${tmux_panes_prompt})+reload(set_mode panes; get_tmux_panes)+transform-footer:get_footer panes\"
  fi
else
  echo \"change-prompt(${tmux_panes_prompt})+reload(set_mode panes; get_tmux_panes)+transform-footer:get_footer panes\"
fi
"

# FZF key bindings — mode-aware via dispatcher functions
del_bind="del:execute(dispatch_del {})+reload(reload_current)"
rename_bind="ctrl-e:execute(dispatch_rename {})+reload(reload_current)"
fzf_binds='enter:accept-or-print-query,tab:down,shift-tab:up'

# Theme configuration
theme_opts=()
. "$HOME/.config/themes/lib/resolve-theme.sh"
selected_theme=$THEME
theme_file="$HOME/.config/themes/generated/fzf/${selected_theme}.sh"

if [[ -f "$theme_file" ]]; then
  set -o noglob
  source "$theme_file"
  set +o noglob
fi

# Professional layout configuration
if [[ -n "$TMUX" ]]; then
  layout="--tmux center,95%,85% --reverse --no-scrollbar"
else
  layout="--height 85% --layout=reverse --margin 1% --no-scrollbar"
fi

# Professional footer with keymaps section and improved alignment
footer=$'󰌌 Keymaps:\n  󰘳  ?         Switch Modes\n  󰐊  Alt-p     Toggle Preview\n  󰌑  Enter     Attach/Start Session\n  󰑕  Ctrl-e    Rename Session\n  󰅖  Del       Kill Session'

# Enhanced FZF options with professional styling
fzf_opts=(
  "${theme_opts[@]}"
  --ansi
  --cycle
  --delimiter '\t'
  --with-nth '2..'
  --header-lines=1
  --header-lines-border=inline
  --border rounded
  --border-label "  󰓫 Tmux Session Manager  "
  --style full
  --info inline-right
  --prompt "❯ "
  --pointer "󰁕"
  --marker "󰄲"
  --padding 1,3
  --header-first
  --footer "$footer"
  --footer-border=inline
  --preview-window "right,50%,border-left,wrap,hidden"
  --no-separator
  --bind "$fzf_binds"
  --bind "$del_bind"
  --bind "$rename_bind"
  $layout
  --bind "?:transform:$TRANSFORMER"
  --bind "ctrl-/,ctrl-_,alt-p:toggle-preview"
  --preview 'generate_preview {}'
)

# ================================================================================
#                           CORE SESSION LOGIC
# ================================================================================
# Main functions for session attachment and management
tmux_start_session_in_dir() {
  local session="$1"
  local session_dir="$2"
  local tmux_action=$([[ -n "$TMUX" ]] && echo "switch-client" || echo "attach-session")

  if [[ -n "$session_dir" && -d "$session_dir" ]]; then
    local new_session=$(basename "$session_dir")
    cd "$session_dir" 2>/dev/null || {
      echo "$session_dir can't be accessed"
      return 1
    }
    tmux new-session -d -s "$new_session" -c "$session_dir" 2>/dev/null &&
      tmux "$tmux_action" -t "$new_session"
  else
    # Use HOME as fallback
    session_dir="$HOME"
    cd "$session_dir" || return 1
    tmux new-session -d -s "$session" -c "$session_dir" 2>/dev/null &&
      tmux "$tmux_action" -t "$session"
  fi
  return 0
}
export -f tmux_start_session_in_dir

tmux_attach_start() {
  local raw_selection="$1"
  local mode="$2"
  # Extract action key (before tab) — unified for all modes
  local session="${raw_selection%%$'\t'*}"
  session="${session% (attached)}"
  local tmux_action=$([[ -n "$TMUX" ]] && echo "switch-client" || echo "attach-session")
  # Pane mode: action key is the full tmux target (session:window.pane).
  # Only treat as pane if the selection was an actual list item (contains a tab).
  # A typed query (no tab) falls through to session creation below.
  if [[ $(cat $PROMPT_MODE_FILE) == "panes" && "$raw_selection" == *$'\t'* ]]; then
    tmux $tmux_action -t "$session"
    return 0
  fi

  if [[ "$mode" == "term" ]]; then
    create_session "$session" "$tmux_action"
    return 0
  fi

  # 1. Check if it's an existing tmux session
  if tmux has-session -t "$session" 2>/dev/null; then
    tmux "$tmux_action" -t "$session"
    return 0
  fi

  # 2. Zoxide mode: action key is a full path from list, or a raw query from user input
  if [[ $(cat $PROMPT_MODE_FILE) == "zoxide" ]]; then
    local session_dir
    if [[ -d "$session" ]]; then
      session_dir="$session"
    else
      session_dir=$(zoxide query "$session" 2>/dev/null)
    fi
    tmux_start_session_in_dir "$session" "$session_dir"
    return 0
  fi

  # 3. Fallback: try starting a new session
  tmux_start_session_in_dir "$session"
}

# ================================================================================
#                           MAIN REQUEST HANDLER
# ================================================================================
# Entry point and flow control

handler_request() {
  local shell session tmux_sessions selection panes_data
  shell=$(command -v bash)
  session="$1"
  tmux_sessions=$(get_tmux_sessions)

  if [[ -n "$session" ]]; then
    tmux_attach_start "$session" "term"
    return 0
  fi

  # Build pane data once to avoid duplicate work before launching fzf.
  panes_data=""
  if [[ "$FORCE_PANES" -eq 1 ]] || [[ -n "$TMUX" ]]; then
    panes_data=$(get_tmux_panes)
  fi

  # Start with panes if forced via --panes flag, or if in tmux with available panes
  if [[ "$FORCE_PANES" -eq 1 ]] || [[ -n "$TMUX" && -n "$panes_data" ]]; then
    set_mode "panes"
    selection=$(printf '%s\n' "$panes_data" | SHELL="$shell" fzf "${fzf_opts[@]}" --prompt "$tmux_panes_prompt" --footer "$(get_footer)")
  elif [[ -z "$TMUX" && -z "$tmux_sessions" ]]; then
    set_mode "zoxide"
    selection=$(get_zoxide_dirs | SHELL="$shell" fzf "${fzf_opts[@]}" --prompt "$zoxide_prompt" --footer "$(get_footer)")
  else
    set_mode "tmux"
    selection=$(echo -n -e "$tmux_sessions" | SHELL="$shell" fzf "${fzf_opts[@]}" --prompt "$tmux_sessions_prompt" --footer "$(get_footer)")
  fi

  [[ -z "$selection" ]] && return 0
  
  tmux_attach_start "$selection" "fzf"
  return 0
}

# ================================================================================
#                               ENTRY POINT
# ================================================================================
# Argument validation and script execution

FORCE_PANES=0
session_arg=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --panes)
      FORCE_PANES=1
      shift
      ;;
    -*)
      echo "Unknown option: $1" >&2
      echo "Usage: $(basename "$0") [--panes] [session-name]" >&2
      exit 1
      ;;
    *)
      if [[ -n "$session_arg" ]]; then
        echo "Usage: $(basename "$0") [--panes] [session-name]" >&2
        exit 1
      fi
      session_arg="$1"
      shift
      ;;
  esac
done

# Start the main handler
handler_request "$session_arg"
