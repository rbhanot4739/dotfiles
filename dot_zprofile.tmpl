# vim:ft=zsh
# =====================================
# Locale
# =====================================
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

# =====================================
# XDG Base Directories
# =====================================
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"

# =====================================
# PATH Modifications
# =====================================
[[ -d "$HOME/bin"    ]] && export PATH="$HOME/bin:$PATH"
[[ -d "$HOME/.local/bin"    ]] && export PATH="$HOME/.local/bin:$PATH"
[[ -d "$HOME/scripts"            ]] && export PATH="$HOME/scripts:$PATH"
[[ -d "$HOME/.config/themes/bin" ]] && export PATH="$HOME/.config/themes/bin:$PATH"   # theme-switch, theme-generate
[[ -d "/nix/profiles/$USER/default/bin" ]] && export PATH="/nix/profiles/$USER/default/bin:$PATH"

typeset -U path

# =====================================
# Homebrew — must come before Editor/Pager so command -v resolves brew bins
# =====================================

{{- if .is_mac }}
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi
{{- else if not .is_linux_work }}
if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi
{{- end }}

# =====================================
# Editor and Pager
# =====================================
if command -v nvim >/dev/null; then
  export EDITOR="nvim"
else
  export EDITOR="vim"
fi

export VISUAL="$EDITOR"

# =====================================
# Bat Configuration
# =====================================
if command -v bat >/dev/null; then
  export PAGER="bat"
  export MANPAGER="sh -c 'col -bx | bat -l man -p'"
  export MANROFFOPT="-c"
else
  export PAGER="less -R"
  export MANPAGER="less -R"
fi


# Lazygit: overlay active theme on top of main config (theme-switch writes the active file)
export LG_CONFIG_FILE="$HOME/.config/lazygit/config.yml,$HOME/.config/themes/generated/lazygit/lazygit-active-theme.yml"

# fzf colours: theme-switch rewrites this file, and every new fzf picks it up live.
# Guarded: fzf refuses to start if FZF_DEFAULT_OPTS_FILE points at a missing file
# (it is created by theme-generate / theme-switch).
[[ -f "$HOME/.config/themes/generated/fzf/active.opts" ]] && \
  export FZF_DEFAULT_OPTS_FILE="$HOME/.config/themes/generated/fzf/active.opts"
