; vim: set filetype=gitconfig:

[include]
    path = ~/.config/themes/generated/delta/delta-themes.gitconfig
    path = ~/.config/themes/generated/delta/delta-active.gitconfig

[delta]
    true-color = always
    hyperlinks = true
    ; side-by-side = true
    ; line-numbers-left-format = " |"
    ; line-numbers-right-format = "│ "

    ; delta detects terminal colors automatically; set one of these to disable auto-detection
    ; dark = true
    ; light = true
