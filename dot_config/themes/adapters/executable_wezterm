#!/usr/bin/env bash
# macOS only (deployed when is_mac).
# Usage: wezterm <theme> <bg-mode>      (bg-mode: dark|light)
# Prints a WezTerm .toml colour scheme (derived from the registry `colors` section).
set -euo pipefail

THEME="${1:?usage: wezterm <theme> <dark|light>}"
MODE="${2:-dark}"
case "$MODE" in dark|light) ;; *) echo "Error: bg-mode must be dark or light" >&2; exit 2 ;; esac

. "$(dirname "$0")/../lib/registry.sh"
theme_load "$THEME" "$MODE" colors
theme_need background foreground cursor selection_bg selection_fg \
  black red green yellow blue magenta cyan white \
  bright_black bright_red bright_green bright_yellow bright_blue bright_magenta bright_cyan bright_white

cat <<TOML
[metadata]
name = "${THEME}"

[colors]
foreground    = "${V_foreground}"
background    = "${V_background}"
cursor_bg     = "${V_cursor}"
cursor_border = "${V_cursor}"
cursor_fg     = "${V_background}"
selection_bg  = "${V_selection_bg}"
selection_fg  = "${V_selection_fg}"

ansi    = ["${V_black}", "${V_red}", "${V_green}", "${V_yellow}", "${V_blue}", "${V_magenta}", "${V_cyan}", "${V_white}"]
brights = ["${V_bright_black}", "${V_bright_red}", "${V_bright_green}", "${V_bright_yellow}", "${V_bright_blue}", "${V_bright_magenta}", "${V_bright_cyan}", "${V_bright_white}"]
TOML
