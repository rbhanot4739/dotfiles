#!/usr/bin/env bash
# macOS only (deployed when is_mac).
# Usage: ghostty <theme> <bg-mode>      (bg-mode: dark|light)
# Prints a Ghostty colour block: either `theme = <built-in>` when the registry names
# one (terminal.ghostty_theme), or background/foreground/cursor/selection + palette 0-15.
set -euo pipefail

THEME="${1:?usage: ghostty <theme> <dark|light>}"
MODE="${2:-dark}"
case "$MODE" in dark|light) ;; *) echo "Error: bg-mode must be dark or light" >&2; exit 2 ;; esac

. "$(dirname "$0")/../lib/registry.sh"

# A built-in Ghostty theme wins if the registry references one.
theme_load "$THEME" "$MODE" terminal 2>/dev/null || true
if [ -n "${V_ghostty_theme:-}" ] && [ "$V_ghostty_theme" != "null" ]; then
  printf 'theme = %s\n' "$V_ghostty_theme"
  exit 0
fi

theme_load "$THEME" "$MODE" colors
theme_need background foreground cursor selection_bg selection_fg \
  black red green yellow blue magenta cyan white \
  bright_black bright_red bright_green bright_yellow bright_blue bright_magenta bright_cyan bright_white

cat <<CONF
background = ${V_background}
foreground = ${V_foreground}
cursor-color = ${V_cursor}
selection-background = ${V_selection_bg}
selection-foreground = ${V_selection_fg}

palette = 0=${V_black}
palette = 1=${V_red}
palette = 2=${V_green}
palette = 3=${V_yellow}
palette = 4=${V_blue}
palette = 5=${V_magenta}
palette = 6=${V_cyan}
palette = 7=${V_white}
palette = 8=${V_bright_black}
palette = 9=${V_bright_red}
palette = 10=${V_bright_green}
palette = 11=${V_bright_yellow}
palette = 12=${V_bright_blue}
palette = 13=${V_bright_magenta}
palette = 14=${V_bright_cyan}
palette = 15=${V_bright_white}
CONF
