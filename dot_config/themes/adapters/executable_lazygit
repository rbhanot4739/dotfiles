#!/usr/bin/env bash
# Usage: lazygit <theme> <bg-mode>      (bg-mode: dark|light)
# Prints a lazygit `gui.theme` YAML overlay to stdout. List values come out as
# YAML flow lists, e.g. ["#ff9e64","bold"].
set -euo pipefail

THEME="${1:?usage: lazygit <theme> <dark|light>}"
MODE="${2:-dark}"
case "$MODE" in dark|light) ;; *) echo "Error: bg-mode must be dark or light" >&2; exit 2 ;; esac

. "$(dirname "$0")/../lib/registry.sh"
theme_load "$THEME" "$MODE" lazygit
theme_need active_border_color inactive_border_color searching_active_border \
  options_text_color selected_line_bg_color cherry_picked_commit_fg cherry_picked_commit_bg \
  marked_base_commit_fg marked_base_commit_bg unstaged_changes_color default_fg_color

# nerdFontsVersion is deliberately not set here: it belongs to the main lazygit
# config, this file is only the colour overlay.
cat <<YAML
gui:
  theme:
    activeBorderColor: ${V_active_border_color}
    inactiveBorderColor: ${V_inactive_border_color}
    searchingActiveBorderColor: ${V_searching_active_border}
    optionsTextColor: ${V_options_text_color}
    selectedLineBgColor: ${V_selected_line_bg_color}
    cherryPickedCommitFgColor: ${V_cherry_picked_commit_fg}
    cherryPickedCommitBgColor: ${V_cherry_picked_commit_bg}
    markedBaseCommitFgColor: ${V_marked_base_commit_fg}
    markedBaseCommitBgColor: ${V_marked_base_commit_bg}
    unstagedChangesColor: ${V_unstaged_changes_color}
    defaultFgColor: ${V_default_fg_color}
YAML
