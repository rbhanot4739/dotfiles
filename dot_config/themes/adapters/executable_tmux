#!/usr/bin/env bash
# Usage: tmux <theme-name> <bg-mode>
# Emits: tmux set -g commands to stdout
set -euo pipefail

THEME="$1"
MODE="${2:-dark}"
REGISTRY="$HOME/.config/themes/registry"
YAML="$REGISTRY/${THEME}.yaml"

[[ ! -f "$YAML" ]] && { echo "Error: theme not found: $YAML" >&2; exit 1; }

THEME_MODE=$(yq '.mode' "$YAML")

yv() {
  if [[ "$THEME_MODE" == "adaptive" ]]; then
    yq ".${MODE}.tmux.${1}" "$YAML"
  else
    yq ".tmux.${1}" "$YAML"
  fi
}

cat <<CONF
# vim:set ft=tmux:
# Generated by theme-generate — do not edit directly

set -g @DEFAULT_BG "$(yv default_bg)"
set -g @DEFAULT_FG "$(yv default_fg)"
set -g @ACTIVE_PANE_BORDER_COL "$(yv active_pane_border)"
set -g @INACTIVE_PANE_BORDER_COL "$(yv inactive_pane_border)"

set -g @PREFIX_COL "$(yv prefix_indicator)"
set -g @LEFT_1_BG "$(yv left1_bg)"
set -g @LEFT_1_FG "$(yv left1_fg)"

set -g @WINDOW_CURR_BG "$(yv window_curr_bg)"
set -g @WINDOW_CURR_FG "$(yv window_curr_fg)"
set -g @WINDOW_BG "$(yv window_bg)"
set -g @WINDOW_FG "$(yv window_fg)"

set -g @COPY_MODE_BG "$(yv copy_mode_bg)"
set -g @COPY_MODE_FG "$(yv copy_mode_fg)"

set -g @SYNC_COL "$(yv sync_color)"
set -g @RIGHT_1_BG "$(yv right1_bg)"
set -g @RIGHT_1_FG "$(yv right1_fg)"
set -g @RIGHT_2_BG "$(yv right2_bg)"
set -g @RIGHT_2_FG "$(yv right2_fg)"
CONF
