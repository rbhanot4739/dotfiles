#!/usr/bin/env bash
# Usage: tmux <theme> <bg-mode>      (bg-mode: dark|light)
# Prints tmux `set -g @VAR` lines for the theme to stdout.
set -euo pipefail

THEME="${1:?usage: tmux <theme> <dark|light>}"
MODE="${2:-dark}"
case "$MODE" in dark|light) ;; *) echo "Error: bg-mode must be dark or light" >&2; exit 2 ;; esac

. "$(dirname "$0")/../lib/registry.sh"
theme_load "$THEME" "$MODE" tmux
theme_need default_bg default_fg active_pane_border inactive_pane_border \
  prefix_indicator left1_bg left1_fg window_curr_bg window_curr_fg window_bg window_fg \
  copy_mode_bg copy_mode_fg sync_color right1_bg right1_fg right2_bg right2_fg

cat <<CONF
# vim:set ft=tmux:
# Generated by theme-generate — do not edit directly

set -g @DEFAULT_BG "${V_default_bg}"
set -g @DEFAULT_FG "${V_default_fg}"
set -g @ACTIVE_PANE_BORDER_COL "${V_active_pane_border}"
set -g @INACTIVE_PANE_BORDER_COL "${V_inactive_pane_border}"

set -g @PREFIX_COL "${V_prefix_indicator}"
set -g @LEFT_1_BG "${V_left1_bg}"
set -g @LEFT_1_FG "${V_left1_fg}"

set -g @WINDOW_CURR_BG "${V_window_curr_bg}"
set -g @WINDOW_CURR_FG "${V_window_curr_fg}"
set -g @WINDOW_BG "${V_window_bg}"
set -g @WINDOW_FG "${V_window_fg}"

set -g @COPY_MODE_BG "${V_copy_mode_bg}"
set -g @COPY_MODE_FG "${V_copy_mode_fg}"

set -g @SYNC_COL "${V_sync_color}"
set -g @RIGHT_1_BG "${V_right1_bg}"
set -g @RIGHT_1_FG "${V_right1_fg}"
set -g @RIGHT_2_BG "${V_right2_bg}"
set -g @RIGHT_2_FG "${V_right2_fg}"
CONF
