#!/usr/bin/env bash
# Usage: delta <theme> <bg-mode>      (bg-mode: dark|light)
# Prints a `[delta "<section>"]` gitconfig block to stdout.
set -euo pipefail

THEME="${1:?usage: delta <theme> <dark|light>}"
MODE="${2:-dark}"
case "$MODE" in dark|light) ;; *) echo "Error: bg-mode must be dark or light" >&2; exit 2 ;; esac

. "$(dirname "$0")/../lib/registry.sh"
theme_load "$THEME" "$MODE" delta
theme_need section_name minus_style minus_non_emph_style minus_emph_style \
  minus_empty_line_marker_style line_numbers_minus_style plus_style plus_non_emph_style \
  plus_emph_style plus_empty_line_marker_style line_numbers_plus_style line_numbers_zero_style

cat <<GITCONFIG
[delta "${V_section_name}"]
  minus-style                   = ${V_minus_style}
  minus-non-emph-style          = ${V_minus_non_emph_style}
  minus-emph-style              = ${V_minus_emph_style}
  minus-empty-line-marker-style = ${V_minus_empty_line_marker_style}
  line-numbers-minus-style      = ${V_line_numbers_minus_style}
  plus-style                    = ${V_plus_style}
  plus-non-emph-style           = ${V_plus_non_emph_style}
  plus-emph-style               = ${V_plus_emph_style}
  plus-empty-line-marker-style  = ${V_plus_empty_line_marker_style}
  line-numbers-plus-style       = ${V_line_numbers_plus_style}
  line-numbers-zero-style       = ${V_line_numbers_zero_style}
GITCONFIG
