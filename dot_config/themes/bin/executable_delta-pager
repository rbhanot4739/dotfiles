#!/usr/bin/env bash
# Wrapper for delta that auto-detects light/dark from ~/.bg_mode.
# Used as lazygit's pager so the config never needs runtime mutation.
# Also self-heals delta-active.gitconfig if theme-switch left it stale.
set -euo pipefail
mode=$(cat "$HOME/.bg_mode" 2>/dev/null | tr -d '[:space:]')
mode="${mode:-dark}"

# Self-heal: ensure delta-active.gitconfig matches current mode.
# Guards against theme-switch failures leaving a stale features= line.
_theme=$(cat "$HOME/.theme_${mode}" 2>/dev/null | tr -d '[:space:]' || true)
_yaml="$HOME/.config/themes/registry/${_theme:-}.yaml"
if [[ -n "${_theme:-}" && -f "$_yaml" ]]; then
  _tmode=$(yq '.mode' "$_yaml" 2>/dev/null || true)
  if [[ "$_tmode" == "adaptive" ]]; then
    _section=$(yq ".${mode}.delta.section_name" "$_yaml" 2>/dev/null || true)
  else
    _section=$(yq ".delta.section_name" "$_yaml" 2>/dev/null || true)
  fi
  if [[ -n "${_section:-}" && "$_section" != "null" ]]; then
    _active="$HOME/.config/themes/generated/delta/delta-active.gitconfig"
    _current=$(grep 'features' "$_active" 2>/dev/null | awk '{print $3}' || true)
    if [[ "$_current" != "$_section" ]]; then
      printf '; Auto-generated by delta-pager (self-heal)\n[delta]\n    features = %s\n' \
        "$_section" > "$_active"
    fi
  fi
fi

exec delta "--${mode}" "$@"
