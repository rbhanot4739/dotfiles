#!/usr/bin/env bash
# theme-generate [--no-apply] [--quiet]
#
# Compiles registry/*.yaml into per-tool files under $THEMES_GENERATED
# (default ~/.config/themes/generated):
#
#   fzf/<key>.sh        sourceable `theme_opts=(...)` array
#   fzf/<key>.opts      one --color option per line (for FZF_DEFAULT_OPTS_FILE)
#   tmux/<key>.conf     `set -g @VAR` lines
#   lazygit/<key>.yml   gui.theme overlay
#   delta/sections/<key>.gitconfig   one [delta "<section>"] block per theme
#   delta/delta-themes.gitconfig     all sections concatenated
#
# <key> is "<name>-dark" / "<name>-light" for adaptive themes, "<name>" otherwise.
# Everything is built in a staging directory first: if any theme fails, nothing in
# the generated tree is touched. Active files written by theme-switch
# (active.*, delta-active.gitconfig, lazygit-active-theme.yml) are never removed.
#
# Extra generators (e.g. terminal-specific ones) can drop executables into
# hooks/generate.d/; they run after the core files, with THEMES_ROOT,
# THEMES_REGISTRY and THEMES_GENERATED exported. A failing hook only warns.
set -euo pipefail

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SELF_DIR/../lib/registry.sh"
. "$SELF_DIR/../lib/state.sh"
export THEMES_ROOT THEMES_REGISTRY THEMES_GENERATED

APPLY=1
QUIET=0
for arg in "$@"; do
  case "$arg" in
    --no-apply) APPLY=0 ;;
    -q|--quiet) QUIET=1 ;;
    -h|--help)  sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "Usage: theme-generate [--no-apply] [--quiet]" >&2; exit 2 ;;
  esac
done

say()  { [ "$QUIET" = 1 ] || printf '%s\n' "$*"; }
warn() { printf 'theme-generate: %s\n' "$*" >&2; }

themes=$(registry_list)
[ -n "$themes" ] || { echo "Error: no themes in $THEMES_REGISTRY" >&2; exit 1; }

mkdir -p "$THEMES_GENERATED"
STAGE=$(mktemp -d "$THEMES_GENERATED/.stage.XXXXXX")
trap 'rm -rf "$STAGE"' EXIT
mkdir -p "$STAGE/fzf" "$STAGE/tmux" "$STAGE/lazygit" "$STAGE/delta/sections"

errors=0
nkeys=0

fail() { errors=$((errors + 1)); warn "$*"; }

# gen <adapter> <theme> <bg-mode> <outfile> [adapter args...]
gen() {
  local adapter="$1" theme="$2" bg="$3" out="$4"
  shift 4
  if ! "$THEMES_ROOT/adapters/$adapter" "$theme" "$bg" "$@" > "$out" 2> "$STAGE/err"; then
    fail "$theme ($bg): adapter '$adapter' failed: $(tr '\n' ' ' < "$STAGE/err")"
    return 1
  fi
}

for theme in $themes; do
  if ! theme_meta "$theme" 2> "$STAGE/err"; then
    fail "$theme: $(tr '\n' ' ' < "$STAGE/err")"
    continue
  fi
  if [ "$T_mode" = adaptive ]; then modes="dark light"; else modes="$T_mode"; fi
  for bg in $modes; do
    if [ "$T_mode" = adaptive ]; then key="$theme-$bg"; else key="$theme"; fi
    nkeys=$((nkeys + 1))
    gen fzf     "$theme" "$bg" "$STAGE/fzf/$key.sh" || true
    gen fzf     "$theme" "$bg" "$STAGE/fzf/$key.opts" --opts || true
    gen tmux    "$theme" "$bg" "$STAGE/tmux/$key.conf" || true
    gen lazygit "$theme" "$bg" "$STAGE/lazygit/$key.yml" || true
    gen delta   "$theme" "$bg" "$STAGE/delta/sections/$key.gitconfig" || true
  done
done

if [ "$errors" -gt 0 ]; then
  echo "theme-generate: $errors error(s); generated files left unchanged." >&2
  exit 1
fi

# delta: one aggregate file with every section.
{
  echo '; vim: set filetype=gitconfig:'
  echo
  for f in "$STAGE"/delta/sections/*.gitconfig; do
    cat "$f"
    echo
  done
} > "$STAGE/delta-themes.gitconfig"

# --- commit: move new files over old ones, then drop files that no longer belong ---
is_active() {
  case "$1" in active.*|lazygit-active-theme.yml|delta-active.gitconfig) return 0 ;; esac
  return 1
}

for d in fzf tmux lazygit delta/sections; do
  mkdir -p "$THEMES_GENERATED/$d"
  keep=""
  for f in "$STAGE/$d"/*; do
    name="${f##*/}"
    keep="$keep
$name"
    mv -f "$f" "$THEMES_GENERATED/$d/$name"
  done
  for f in "$THEMES_GENERATED/$d"/*; do
    [ -f "$f" ] || continue
    name="${f##*/}"
    is_active "$name" && continue
    case "$keep
" in *"
$name
"*) ;; *) rm -f "$f" ;; esac
  done
done
mkdir -p "$THEMES_GENERATED/delta"
mv -f "$STAGE/delta-themes.gitconfig" "$THEMES_GENERATED/delta/delta-themes.gitconfig"

say "Generated $nkeys theme variants into $THEMES_GENERATED"

# --- optional extra generators ---------------------------------------------------
if [ -d "$THEMES_ROOT/hooks/generate.d" ]; then
  for hook in "$THEMES_ROOT"/hooks/generate.d/*; do
    [ -f "$hook" ] && [ -x "$hook" ] || continue
    say "Running hook ${hook##*/}"
    "$hook" || warn "hook ${hook##*/} failed (continuing)"
  done
fi

# --- apply the current theme ------------------------------------------------------
if [ "$APPLY" = 1 ]; then
  if [ -x "$SELF_DIR/theme-switch" ]; then
    if [ "$QUIET" = 1 ]; then
      "$SELF_DIR/theme-switch" --apply --quiet || warn "theme-switch failed"
    else
      "$SELF_DIR/theme-switch" --apply || warn "theme-switch failed"
    fi
  else
    say "(theme-switch is not installed yet: nothing applied)"
  fi
fi
