#!/usr/bin/env bash
# Regenerates all generated/ artifacts from registry YAMLs
# Run this after editing any registry YAML file
set -euo pipefail

THEMES_DIR="$HOME/.config/themes"
REGISTRY="$THEMES_DIR/registry"
ADAPTERS="$THEMES_DIR/adapters"
GENERATED="$THEMES_DIR/generated"

# Ensure generated dirs exist
mkdir -p "$GENERATED"/{fzf,tmux,ghostty,delta,lazygit}
WEZTERM_COLORS_DIR="$HOME/.config/wezterm/colors"
mkdir -p "$WEZTERM_COLORS_DIR"

# Accumulator for delta themes gitconfig
DELTA_OUT="$GENERATED/delta/delta-themes.gitconfig"
echo '; vim: set filetype=gitconfig:' > "$DELTA_OUT"
echo '' >> "$DELTA_OUT"

process_theme() {
  local yaml="$1"
  local name
  name=$(yq '.name' "$yaml")
  local mode
  mode=$(yq '.mode' "$yaml")

  if [[ "$mode" == "adaptive" ]]; then
    for bg in dark light; do
      echo "  [adaptive] $name-$bg"

      # fzf
      "$ADAPTERS/fzf" "$name" "$bg" > "$GENERATED/fzf/${name}-${bg}.sh"

      # tmux
      "$ADAPTERS/tmux" "$name" "$bg" > "$GENERATED/tmux/${name}-${bg}.conf"

      # ghostty
      "$ADAPTERS/ghostty" "$name" "$bg" > "$GENERATED/ghostty/${name}-${bg}.conf"

      # delta - append to combined file
      "$ADAPTERS/delta" "$name" "$bg" >> "$DELTA_OUT"
      echo '' >> "$DELTA_OUT"

      # lazygit
      "$ADAPTERS/lazygit" "$name" "$bg" > "$GENERATED/lazygit/${name}-${bg}.yml"

      # wezterm - custom .toml (used as fallback when no built-in scheme matches)
      "$ADAPTERS/wezterm" "$name" "$bg" > "$WEZTERM_COLORS_DIR/${name}-${bg}.toml"
    done
  else
    echo "  [single]   $name ($mode)"

    # fzf
    "$ADAPTERS/fzf" "$name" "$mode" > "$GENERATED/fzf/${name}.sh"

    # tmux
    "$ADAPTERS/tmux" "$name" "$mode" > "$GENERATED/tmux/${name}.conf"

    # ghostty - always include mode in filename for compatibility
    "$ADAPTERS/ghostty" "$name" "$mode" > "$GENERATED/ghostty/${name}-${mode}.conf"

    # delta
    "$ADAPTERS/delta" "$name" "$mode" >> "$DELTA_OUT"
    echo '' >> "$DELTA_OUT"

    # lazygit
    "$ADAPTERS/lazygit" "$name" "$mode" > "$GENERATED/lazygit/${name}-${mode}.yml"

    # wezterm - custom .toml (used as fallback when no built-in scheme matches)
    "$ADAPTERS/wezterm" "$name" "$mode" > "$WEZTERM_COLORS_DIR/${name}.toml"
  fi
}

# Generate WezTerm themes Lua module
WEZTERM_THEMES_LUA="$HOME/.wezterm_themes.lua"
{
  echo '-- Auto-generated by theme-generate — do not edit directly'
  echo '-- Source: ~/.config/themes/registry/*.yaml'
  echo ''
  echo 'local M = {}'
  echo ''
  echo 'M.themes = {'
} > "$WEZTERM_THEMES_LUA"

for yaml in "$REGISTRY"/*.yaml; do
  local_name=$(yq '.name' "$yaml")
  local_mode=$(yq '.mode' "$yaml")

  if [[ "$local_mode" == "adaptive" ]]; then
    dark_scheme=$(yq '.dark.terminal.wezterm_scheme' "$yaml")
    light_scheme=$(yq '.light.terminal.wezterm_scheme' "$yaml")
    # Fall back to "<name>-dark" / "<name>-light" (custom .toml) if no built-in defined
    [[ "$dark_scheme" == "null" ]]  && dark_scheme="${local_name}-dark"
    [[ "$light_scheme" == "null" ]] && light_scheme="${local_name}-light"
    echo "  [\"${local_name}\"] = { dark = \"${dark_scheme}\", light = \"${light_scheme}\" }," >> "$WEZTERM_THEMES_LUA"
  else
    scheme=$(yq '.terminal.wezterm_scheme' "$yaml")
    # Fall back to the theme name itself (custom .toml) if no built-in defined
    [[ "$scheme" == "null" ]] && scheme="$local_name"
    echo "  [\"${local_name}\"] = \"${scheme}\"," >> "$WEZTERM_THEMES_LUA"
  fi
done

{
  echo '}'
  echo ''
  echo 'return M'
} >> "$WEZTERM_THEMES_LUA"

echo "Generated: $WEZTERM_THEMES_LUA"

# Process all themes
echo "Processing themes..."
for yaml in "$REGISTRY"/*.yaml; do
  process_theme "$yaml"
done

echo ""
echo "Done! Generated files:"
echo "  fzf:     $(ls "$GENERATED/fzf/" | wc -l | tr -d ' ') files"
echo "  tmux:    $(ls "$GENERATED/tmux/" | wc -l | tr -d ' ') files"
echo "  ghostty: $(ls "$GENERATED/ghostty/" | wc -l | tr -d ' ') files"
echo "  delta:   $DELTA_OUT"
echo "  lazygit: $(ls "$GENERATED/lazygit/" | wc -l | tr -d ' ') files"
echo "  wezterm: $WEZTERM_THEMES_LUA"
echo "  wezterm colors: $(ls "$WEZTERM_COLORS_DIR/" | wc -l | tr -d ' ') files  ($WEZTERM_COLORS_DIR)"
