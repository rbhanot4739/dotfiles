ok "Written: ${OUTPUT}"

# ── Update theme-imports.lua if a neovim plugin was selected ──────────────────
if [[ -n "$NVIM_PLUGIN" ]]; then
  if [[ ! -f "$THEME_IMPORTS" ]]; then
    cat > "$THEME_IMPORTS" << 'LUA'
-- Auto-managed by theme-import — do not edit manually
return {
}
LUA
  fi
  if ! grep -qF "\"$NVIM_PLUGIN\"" "$THEME_IMPORTS"; then
    tmp=$(mktemp)
    sed '$d' "$THEME_IMPORTS" > "$tmp"
    echo "  { \"$NVIM_PLUGIN\", lazy = false, priority = 1000 }," >> "$tmp"
    echo "}" >> "$tmp"
    mv "$tmp" "$THEME_IMPORTS"
    ok "neovim: added '${NVIM_PLUGIN}' to theme-imports.lua — run :Lazy sync in nvim"
  else
    info "neovim: '${NVIM_PLUGIN}' already in theme-imports.lua"
  fi
fi

printf '\n  Running theme-generate...\n'
"$THEMES_BIN/theme-generate"
ok "All tool configs generated"

printf '\n'
if [[ "$ASSUME_YES" == "1" ]]; then
  _apply="y"
else
  read -rp "  Apply '${THEME_ARG}' now? [Y/n] " _apply
fi
if [[ "${_apply:-y}" =~ ^[Yy]$ ]]; then
  echo "$THEME_ARG" > "$HOME/.theme_${MODE}"
  "$THEMES_BIN/theme-switch"
  ok "Theme applied!"
fi
