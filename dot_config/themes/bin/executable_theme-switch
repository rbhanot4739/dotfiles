#!/usr/bin/env bash
# theme-switch [-q|--quiet] [<theme> | dark | light | --mode [dark|light]]
# theme-switch --list | --apply
#
#   (no argument)  fzf popup with every theme in the registry; Enter applies it.
#                  Without a terminal (and outside tmux) it prints the list instead.
#   --apply        re-apply the current state (never prompts); used by theme-generate
#   <theme>        use that theme. Themes that are dark-only or light-only also set
#                  ~/.bg_mode to match; adaptive themes keep the current mode.
#   dark | light   set ~/.bg_mode and apply the theme remembered for that mode.
#   --mode         small fzf popup to choose dark or light. Without a terminal (and outside
#                  tmux) it prints the current mode. `--mode dark|light` = `dark|light`.
#   --list         print all themes: name, mode, description. '*' = active now,
#                  '+' = remembered for the other mode. Lines starting with # are header.
#
# State files (shared with nvim and the shell):
#   ~/.bg_mode                   dark | light
#   ~/.theme_dark ~/.theme_light the theme chosen for each mode
#
# Applies to: tmux (source-file + fzf-url options), fzf (generated/fzf/active.*),
# delta (generated/delta/delta-active.gitconfig), lazygit
# (generated/lazygit/lazygit-active-theme.yml), running Neovim instances (nvr), then any
# executables in hooks/apply.d/ (env: THEME BG_MODE THEME_KEY THEMES_QUIET THEMES_GENERATED).
# Missing generated files are created by running theme-generate once.
# Set THEMES_SKIP_NVIM=1 to skip the Neovim step.
set -euo pipefail

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SELF_DIR/../lib/registry.sh"
. "$SELF_DIR/../lib/state.sh"
. "$SELF_DIR/../lib/util.sh"
. "$SELF_DIR/../lib/picker.sh"
export THEMES_ROOT THEMES_REGISTRY THEMES_GENERATED

QUIET=0
LIST=0
APPLY_ONLY=0
MODE_PICK=0
TARGET=""
for arg in "$@"; do
  case "$arg" in
    -q|--quiet) QUIET=1 ;;
    -l|--list)  LIST=1 ;;
    --apply)    APPLY_ONLY=1 ;;
    --mode)     MODE_PICK=1 ;;
    -h|--help)  awk 'NR > 1 { if (/^#/) { sub(/^# ?/, ""); print } else exit }' "$0"; exit 0 ;;
    -*) echo "theme-switch: unknown option: $arg" >&2; exit 2 ;;
    *)
      if [ -n "$TARGET" ]; then echo "theme-switch: too many arguments" >&2; exit 2; fi
      TARGET="$arg" ;;
  esac
done

log()  { [ "$QUIET" = 1 ] || printf '%s\n' "$*"; }
warn() { printf 'theme-switch: %s\n' "$*" >&2; }

# ---------------------------------------------------------------------------
# listing
# ---------------------------------------------------------------------------

# Rows "name<TAB>display" for the picker/list: themes usable in the current mode
# first (matching mode or adaptive), then the rest. Needs BG_MODE/THEME resolved.
list_rows() {
  local other other_theme t marker line first="" second=""
  if [ "$BG_MODE" = dark ]; then other=light; else other=dark; fi
  other_theme=$(state_read_theme "$other")
  for t in $(registry_list); do
    theme_meta "$t" 2>/dev/null || continue
    marker=" "
    if [ "$t" = "$THEME" ]; then marker="*"
    elif [ "$t" = "$other_theme" ]; then marker="+"
    fi
    line=$(printf '%s\t%s %-20s %-9s %s' "$t" "$marker" "$t" "$T_mode" "$T_description")
    if [ "$T_mode" = adaptive ] || [ "$T_mode" = "$BG_MODE" ]; then
      first="$first$line
"
    else
      second="$second$line
"
    fi
  done
  printf '%s%s' "$first" "$second"
}

print_list() {
  printf '# bg_mode: %s   active theme: %s   (dark: %s, light: %s)\n' \
    "$BG_MODE" "$THEME" "$(state_read_theme dark | sed 's/^$/default/')" "$(state_read_theme light | sed 's/^$/default/')"
  printf '# * active now, + remembered for the other mode\n'
  list_rows | while IFS=$'\t' read -r _ display; do
    [ -n "$display" ] && printf '%s\n' "$display"
  done
}

state_resolve
if [ "$LIST" = 1 ]; then
  [ -z "$TARGET" ] && [ "$MODE_PICK" = 0 ] || { echo "theme-switch: --list takes no other argument" >&2; exit 2; }
  print_list
  exit 0
fi

# ---------------------------------------------------------------------------
# choose what to switch to
# ---------------------------------------------------------------------------

if [ "$APPLY_ONLY" = 1 ] && [ -n "$TARGET" ]; then
  echo "theme-switch: --apply takes no theme argument" >&2
  exit 2
fi

if [ "$MODE_PICK" = 1 ]; then
  if [ "$APPLY_ONLY" = 1 ]; then echo "theme-switch: --mode and --apply cannot be combined" >&2; exit 2; fi
  case "$TARGET" in
    ""|dark|light) ;;
    *) echo "theme-switch: --mode takes dark or light, not '$TARGET'" >&2; exit 2 ;;
  esac
  if [ -z "$TARGET" ]; then
    if [ -z "${TMUX:-}" ] && ! { [ -t 0 ] && [ -t 1 ]; }; then
      printf '%s\n' "$BG_MODE"       # no terminal to pick with: just report
      exit 0
    fi
    rows=""
    for m in dark light; do
      marker=" "
      [ "$m" = "$BG_MODE" ] && marker="*"
      rows="$rows$(printf '%s\t%s %-6s theme: %s' "$m" "$marker" "$m" "$(state_read_theme "$m")")
"
    done
    rc=0
    TARGET=$(printf '%s' "$rows" | picker_run " mode: ${BG_MODE}  " "Enter: switch   Esc: cancel") || rc=$?
    if [ "$rc" -ne 0 ]; then
      [ "$rc" -eq 1 ] && exit 0
      exit "$rc"
    fi
  fi
fi

if [ -z "$TARGET" ] && [ "$APPLY_ONLY" = 0 ]; then
  if [ -n "${TMUX:-}" ] || { [ -t 0 ] && [ -t 1 ]; }; then
    rc=0
    TARGET=$(list_rows | picker_run " ${BG_MODE}:${THEME}  " "Enter: switch   Esc: cancel   (* active, + other mode)") || rc=$?
    if [ "$rc" -ne 0 ]; then
      [ "$rc" -eq 1 ] && exit 0      # cancelled: change nothing
      exit "$rc"
    fi
  else
    print_list                       # no terminal to pick with: just list
    exit 0
  fi
fi

case "$TARGET" in
  "")
    ;;   # re-apply the current state
  dark|light)
    state_set_bg_mode "$TARGET"
    state_resolve
    ;;
  *)
    if ! registry_file "$TARGET" >/dev/null 2>&1; then
      echo "theme-switch: unknown theme '$TARGET' (see: theme-switch --list)" >&2
      exit 1
    fi
    theme_meta "$TARGET" || exit 1
    if [ "$T_mode" != adaptive ] && [ "$T_mode" != "$BG_MODE" ]; then
      log "note: $TARGET is a $T_mode theme, switching bg_mode to $T_mode"
      state_set_bg_mode "$T_mode"
      BG_MODE="$T_mode"
    fi
    state_set_theme "$BG_MODE" "$TARGET"
    state_resolve
    ;;
esac

# A stored theme that no longer exists: say so, and persist the default so nvim,
# the shell and tmux all agree.
if [ "$THEME_FALLBACK" = 1 ]; then
  if [ -n "$THEME_STORED" ]; then
    warn "theme '$THEME_STORED' not found for $BG_MODE mode, using $THEME"
  fi
  [ -f "$THEMES_REGISTRY/$THEME.yaml" ] || { echo "theme-switch: default theme '$THEME' is not in the registry" >&2; exit 1; }
  state_set_theme "$BG_MODE" "$THEME"
fi

# Persist the effective mode too (the file may be missing or invalid on a fresh host);
# nvim and the shell read ~/.bg_mode directly.
[ "$(_state_read "$THEMES_STATE_DIR/.bg_mode")" = "$BG_MODE" ] || state_set_bg_mode "$BG_MODE"

# ---------------------------------------------------------------------------
# make sure the generated files exist
# ---------------------------------------------------------------------------

locate_generated() {
  C_TMUX=$(gen_find tmux conf) && C_FZF_OPTS=$(gen_find fzf opts) && C_FZF_SH=$(gen_find fzf sh) \
    && C_LAZYGIT=$(gen_find lazygit yml) && C_DELTA=$(gen_find delta/sections gitconfig)
}

if ! locate_generated 2>/dev/null; then
  log "generated files for $THEME ($BG_MODE) missing, running theme-generate"
  "$SELF_DIR/theme-generate" --no-apply --quiet || { echo "theme-switch: theme-generate failed" >&2; exit 1; }
  locate_generated || { echo "theme-switch: no generated files for '$THEME' ($BG_MODE) even after theme-generate" >&2; exit 1; }
fi
THEME_KEY="${C_TMUX##*/}"
THEME_KEY="${THEME_KEY%.conf}"

# ---------------------------------------------------------------------------
# apply
# ---------------------------------------------------------------------------
rc=0
fail() { warn "$*"; rc=1; }

# tmux: only if a server is already running (never start one).
apply_tmux() {
  command -v tmux >/dev/null 2>&1 || { log "  tmux     not installed, skipped"; return 0; }
  run_limited 5 tmux list-sessions >/dev/null 2>&1 || { log "  tmux     no server running, skipped"; return 0; }
  local opts="" l
  run_limited 5 tmux source-file "$C_TMUX" || return 1
  # tmux-fzf-url calls raw fzf and reads its options from this variable.
  while IFS= read -r l; do
    [ -n "$l" ] && opts="$opts $l"
  done < "$C_FZF_OPTS"
  run_limited 5 tmux set -g @fzf-url-fzf-options "--tmux center,100%,50% --multi --exit-0 --no-preview$opts" || return 1
  run_limited 5 tmux refresh-client -S >/dev/null 2>&1 || true
  log "  tmux     applied"
}

apply_fzf() {
  atomic_copy "$C_FZF_OPTS" "$THEMES_GENERATED/fzf/active.opts" \
    && atomic_copy "$C_FZF_SH" "$THEMES_GENERATED/fzf/active.sh" || return 1
  log "  fzf      applied"
}

# delta: features = <section>; dark/light is set too, so plain `git diff` through delta
# does not need to auto-detect the terminal background.
apply_delta() {
  local section tmp f="$THEMES_GENERATED/delta/delta-active.gitconfig"
  section=$(sed -n '1s/^\[delta "\(.*\)"\]$/\1/p' "$C_DELTA")
  [ -n "$section" ] || { warn "cannot read delta section name from $C_DELTA"; return 1; }
  mkdir -p "$THEMES_GENERATED/delta"
  tmp=$(mktemp "$f.XXXXXX") || return 1
  {
    printf '; Auto-generated by theme-switch, do not edit\n'
    printf '[delta]\n'
    printf '    features = %s\n' "$section"
    printf '    %s = true\n' "$BG_MODE"
  } > "$tmp" && chmod 644 "$tmp" && mv -f "$tmp" "$f" || { rm -f "$tmp"; return 1; }
  log "  delta    applied ($section)"
}

apply_lazygit() {
  atomic_copy "$C_LAZYGIT" "$THEMES_GENERATED/lazygit/lazygit-active-theme.yml" || return 1
  log "  lazygit  applied"
}

# Neovim: ask every running instance to reload its colorscheme (see Load_colorscheme in
# nvim's config). Backgrounded and time-limited so a stuck instance never blocks us.
apply_nvim() {
  if [ "${THEMES_SKIP_NVIM:-0}" = 1 ] || ! command -v nvr >/dev/null 2>&1; then
    log "  nvim     skipped"
    return 0
  fi
  (
    for sock in $(run_limited 5 nvr --serverlist 2>/dev/null); do
      run_limited 5 nvr --servername "$sock" \
        --remote-expr "execute('silent! lua Load_colorscheme()')" >/dev/null 2>&1 &
    done
    wait
  ) >/dev/null 2>&1 &
  log "  nvim     requested"
}

apply_tmux   || fail "tmux apply failed"
apply_fzf    || fail "fzf apply failed"
apply_delta  || fail "delta apply failed"
apply_lazygit || fail "lazygit apply failed"
apply_nvim

# Optional extra targets (e.g. terminal emulators) live in hooks/apply.d/.
if [ -d "$THEMES_ROOT/hooks/apply.d" ]; then
  export THEME BG_MODE THEME_KEY
  export THEMES_QUIET="$QUIET"
  for hook in "$THEMES_ROOT"/hooks/apply.d/*; do
    [ -f "$hook" ] && [ -x "$hook" ] || continue
    "$hook" || warn "hook ${hook##*/} failed (continuing)"
  done
fi

log "Theme: $THEME ($BG_MODE)"
exit "$rc"
