#!/usr/bin/env bash
# macOS only. theme-generate hook for WezTerm:
#   ~/.config/wezterm/colors/<key>.toml   custom colour schemes (used when no built-in matches)
#   ~/.wezterm_themes.lua                  theme name -> WezTerm scheme map read by .wezterm.lua
set -euo pipefail
ROOT="${THEMES_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}"
. "$ROOT/lib/registry.sh"
. "$ROOT/lib/state.sh"

colors_dir="$HOME/.config/wezterm/colors"
lua_file="$HOME/.wezterm_themes.lua"
mkdir -p "$colors_dir"
stage=$(mktemp -d "$colors_dir/.stage.XXXXXX")
trap 'rm -rf "$stage"' EXIT

lua_escape() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

# scheme_for <theme> <bg> <fallback>: registry terminal.wezterm_scheme, or the fallback
# (the custom .toml of the same name) when it is unset/null.
scheme_for() {
  theme_load "$1" "$2" terminal 2>/dev/null || true
  if [ -n "${V_wezterm_scheme:-}" ] && [ "$V_wezterm_scheme" != "null" ]; then
    printf '%s' "$V_wezterm_scheme"
  else
    printf '%s' "$3"
  fi
}

errors=0
keep=""
{
  echo '-- Auto-generated by theme-generate — do not edit directly'
  echo '-- Source: ~/.config/themes/registry/*.yaml'
  echo
  echo 'local M = {}'
  echo
  echo 'M.themes = {'
} > "$stage/themes.lua"

for theme in $(registry_list); do
  theme_meta "$theme" 2>/dev/null || { echo "wezterm hook: cannot read $theme" >&2; errors=$((errors + 1)); continue; }
  if [ "$T_mode" = adaptive ]; then modes="dark light"; else modes="$T_mode"; fi
  for bg in $modes; do
    if [ "$T_mode" = adaptive ]; then key="$theme-$bg"; else key="$theme"; fi
    if "$ROOT/adapters/wezterm" "$theme" "$bg" > "$stage/$key.toml" 2> "$stage/err"; then
      keep="$keep
$key.toml"
    else
      echo "wezterm hook: $theme ($bg): $(tr '\n' ' ' < "$stage/err")" >&2
      errors=$((errors + 1))
    fi
  done
  if [ "$T_mode" = adaptive ]; then
    d=$(scheme_for "$theme" dark "$theme-dark"); l=$(scheme_for "$theme" light "$theme-light")
    printf '  ["%s"] = { dark = "%s", light = "%s" },\n' "$theme" "$(lua_escape "$d")" "$(lua_escape "$l")" >> "$stage/themes.lua"
  else
    s=$(scheme_for "$theme" "$T_mode" "$theme")
    printf '  ["%s"] = "%s",\n' "$theme" "$(lua_escape "$s")" >> "$stage/themes.lua"
  fi
done
[ "$errors" -eq 0 ] || exit 1

{ echo '}'; echo; echo 'return M'; } >> "$stage/themes.lua"

for f in "$stage"/*.toml; do mv -f "$f" "$colors_dir/${f##*/}"; done
for f in "$colors_dir"/*.toml; do
  [ -f "$f" ] || continue
  case "$keep
" in *"
${f##*/}
"*) ;; *) rm -f "$f" ;; esac
done
mv -f "$stage/themes.lua" "$lua_file"
