# =====================================
# Terminal Behavior
# =====================================

echo -ne '\e[5 q'    # Use beam cursor
autoload -Uz colors && colors

# =====================================
# History
# =====================================

export HISTSIZE=500000
export HISTFILE=~/.zsh_history
export SAVEHIST=$HISTSIZE
export HISTDUP=erase

setopt APPEND_HISTORY INC_APPEND_HISTORY SHARE_HISTORY
setopt HIST_IGNORE_SPACE HIST_IGNORE_ALL_DUPS HIST_SAVE_NO_DUPS
setopt HIST_FIND_NO_DUPS HIST_REDUCE_BLANKS

# Atuin or Custom History Filtering
if command -v atuin >/dev/null; then
    export ATUIN_NOBIND="true"
    eval "$(atuin init zsh)"

    function zvm_after_init() {
        bindkey -M emacs '' atuin-search
        bindkey -M vicmd '' atuin-search
        bindkey -M viins '' atuin-search
        bindkey '^[[1;2A' atuin-up-search
    }
else
    HIST_IGNORE_REGEXES=(
        '^#.*' '^r$' '^ee$' '^xx$' '^c$' '^z' '^zi'
        '^cm apply' '^cmcd$' '^gs' '^h$' '^gpl' '^gps'
        '^git status' '^git pull' '^git push' '^v$'
    )
    HIST_IGNORE_PATTERN_STRING="^($(IFS='|'; echo "${HIST_IGNORE_REGEXES[*]}"))"

    function zshaddhistory() {
        emulate -L zsh
        local cmd=${1%%$'\n'}
        [[ $cmd =~ $HIST_IGNORE_PATTERN_STRING ]] && return 1
        return 0
    }

    function zvm_after_init() {
        bindkey -M vicmd '^[[1;2A' fzf-history-widget
        bindkey -M viins '^[[1;2A' fzf-history-widget
        bindkey -M emacs '^R' fzf-history-widget
        bindkey -M viins '^R' fzf-history-widget
        bindkey -M vicmd '^R' fzf-history-widget
    }
fi

{{ if not .is_mac -}}
# =====================================
# SSH Theme Detection (OSC 11)
# =====================================
_apply_terminal_theme() {
  local response
  printf '\033]11;?\033\\' >/dev/tty
  IFS='' read -r -d $'\033' -t 0.1 response </dev/tty 2>/dev/null || return
  # Response: ]11;rgb:RRRR/GGGG/BBBB — use first byte of R component for brightness
  local hex_r="${response:8:2}"
  local brightness=$(( 16#$hex_r ))
  local mode="dark"
  [[ $brightness -gt 127 ]] && mode="light"
  echo "$mode" >~/.bg_mode
  [[ -x ~/.config/themes/bin/theme-switch ]] && ~/.config/themes/bin/theme-switch
}
[[ -n $SSH_CONNECTION ]] && _apply_terminal_theme
{{- end }}

