function zvm_after_lazy_keybindings() {
  # Line movement (Ctrl+A / Ctrl+E).
  bindkey -M emacs '^A' beginning-of-line                    # Ctrl+A
  bindkey -M emacs '^E' end-of-line                          # Ctrl+E
  bindkey -M viins '^A' beginning-of-line                    # Ctrl+A
  bindkey -M viins '^E' end-of-line                          # Ctrl+E
  bindkey -M vicmd '^A' beginning-of-line                    # Ctrl+A
  bindkey -M vicmd '^E' end-of-line                          # Ctrl+E

  # Word movement (Ctrl+B / Ctrl+W).
  bindkey -M emacs '^B' backward-word                        # Ctrl+B
  bindkey -M emacs '^W' forward-word                         # Ctrl+W
  bindkey -M viins '^B' backward-word                        # Ctrl+B
  bindkey -M viins '^W' forward-word                         # Ctrl+W

}

zinit ice wait"1" lucid
zinit light zdharma-continuum/fast-syntax-highlighting

