# =====================================
# File Manager
# =====================================
function y() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(cat -- "$tmp")" && [[ -n "$cwd" && "$cwd" != "$PWD" ]]; then
        cd "$cwd"
    fi
    rm -f -- "$tmp"
}

# =====================================
# Theme/Visual
# =====================================
export eza_params=('--git' '--group' '--group-directories-first' '--time-style=long-iso' '--color=always' '--icons')
export BAT_THEME="ansi"

# =====================================
# Custom Configs
# =====================================
[[ -f "$HOME/custom_config.zsh" ]] && source "$HOME/custom_config.zsh"

# =====================================
# Completion
# =====================================

CUSTOM_PATHS=($HOME/zsh_functions)
typeset -U fpath=($CUSTOM_PATHS $fpath)
if type brew &>/dev/null; then
  fpath=($(brew --prefix)/share/zsh/site-functions $fpath)
fi
{{- if (contains "linkedin" .chezmoi.fqdnHostname) }}
# fpath=("/usr/local/linkedin/etc/zsh" "/export/content/linkedin/etc/zsh" $fpath)
{{- end }}

# Autoload all functions from zsh_functions directory
for func in $HOME/zsh_functions/*(.N:t); do
    autoload -Uz "$func"
done

autoload -Uz compinit && compinit -C
zinit cdreplay -q &!

# Completion styles
zstyle ':completion:::::' completer _expand _complete _ignored _approximate
zstyle ':completion:*' matcher-list \
    'r:|=* m:{a-zA-Z}={A-Za-z}' \
    'l:|=* r:|=* m:{a-zA-Z}={A-Za-z}' \
    'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' menu no
# Prefer regular files for cat/bat completion while keeping dirs available
# for path traversal.
zstyle ':completion:*:*:(cat|bat):*' file-patterns '*(-.D):regular-files *(-/D):directories'

# SSH completion: hosts only (no user@ suggestions), with hosts sourced from
# your custom helper.
zstyle ':completion:*:(ssh|scp|sftp|rsync):*' tag-order hosts
zstyle -e ':completion:*:(ssh|scp|sftp|rsync):*:hosts' hosts 'reply=($(__fzf_list_hosts))'
# Note: man-page candidates are sourced via the _man override in
# ~/.config/fzf/tab.zsh (uses __fzf_list_man_pages). The :hosts tag isn't
# used by _man, so a zstyle there would be dead config.
zstyle ':completion:*:(ssh|scp|sftp|rsync|man):*' users ""

# FZF + fzf-tab — canonical config lives in ~/.config/fzf/
# Source once here only if not already loaded earlier via custom_config.zsh.
[[ -f "$HOME/.config/fzf/config.zsh" ]] && source "$HOME/.config/fzf/config.zsh"
[[ -f "$HOME/.config/fzf/tab.zsh" ]] && source "$HOME/.config/fzf/tab.zsh"

# =====================================
# Prompt: P10k Theme
# =====================================

[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

# zoxide needs to be loaded last
if command -v zoxide >/dev/null; then
  eval "$(zoxide init zsh)"
  alias zi=__zoxide_zi
  alias zz='z -'
  # cd() { _lazy_zoxide; __zoxide_z "$@"; }
  # z() { _lazy_zoxide; __zoxide_z "$@"; }
fi


